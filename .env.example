# Copy this file to .env (repo root) and fill in real values.
# Next.js and the db/scripts both read from repo-root .env when run via `pnpm` scripts.

# --- Database (Supabase Free Postgres, or any Postgres) ---
# Supabase: Project Settings -> Database -> Connection string -> URI (use the pooler string for serverless).
DATABASE_URL=postgres://postgres:password@localhost:5432/playloop

# --- Auth ---
# Random long strings. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-hex-string
OTP_PEPPER=replace-with-a-different-random-string

# --- Email (Nodemailer/SMTP — Brevo free tier: 300 emails/day) ---
# Leave SMTP_HOST unset in development to log OTP codes to the console instead of sending real email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="playloop <no-reply@playloop.app>"
